rules_version = '2';

// Firestore security rules for the Travel App.
//
// Two jobs here:
//   1. Access control - who may read or write a document. Ownership is the
//      backbone of every rule below.
//   2. Shape validation - what may be written. Anyone with an account can call
//      Firestore directly, so model shape belongs here too.
//
// Collections not matched below are denied to clients by default. Cloud
// Functions using the admin SDK bypass these rules.

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------------
    // Identity helpers
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function uid() {
      return request.auth.uid;
    }

    function owns(data) {
      return signedIn() && data.get('ownerId', '') == uid();
    }

    function ownedBy(data, field) {
      return signedIn() && data.get(field, '') == uid();
    }

    function ownsTrip(tripId) {
      return signedIn()
        && get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', '') == uid();
    }

    // ---------------------------------------------------------------------
    // Shape validation
    // ---------------------------------------------------------------------

    function validUser(data, userId) {
      return data.keys().hasOnly([
               'uid', 'name', 'displayName', 'email', 'profileImage',
               'photoUrl', 'onboardingCompleted', 'authProvider',
               'lastSignInAt', 'createdAt', 'updatedAt'
             ])
        && (!('uid' in data) || data.uid == userId)
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 320))
        && (!('profileImage' in data) || data.profileImage == null
            || (data.profileImage is string && data.profileImage.size() <= 2000))
        && (!('photoUrl' in data) || data.photoUrl == null
            || (data.photoUrl is string && data.photoUrl.size() <= 2000))
        && (!('authProvider' in data) || (data.authProvider is string && data.authProvider.size() <= 80))
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool);
    }

    function validPreference(data) {
      return data.keys().hasOnly([
               'ownerId', 'experienceType', 'activityLevel',
               'spendingStyle', 'interests', 'updatedAt'
             ])
        && data.ownerId is string
        && data.experienceType is list && data.experienceType.size() <= 50
        && data.interests is list && data.interests.size() <= 50
        && data.activityLevel is string && data.activityLevel.size() <= 60
        && data.spendingStyle is string && data.spendingStyle.size() <= 60;
    }

    function validTrip(data, tripId) {
      return data.keys().hasOnly([
               'id', 'ownerId', 'title', 'destination', 'budget', 'days',
               'status', 'travelers', 'currencyCode', 'startDate', 'endDate',
               'rating', 'createdAt', 'updatedAt', 'segments'
             ])
        && data.id == tripId
        && data.ownerId is string
        && data.destination is string && data.destination.size() <= 200
        && (data.title == null || (data.title is string && data.title.size() <= 200))
        && data.budget is number && data.budget >= 0 && data.budget <= 1000000000
        && data.days is int && data.days >= 0 && data.days <= 365
        && data.status is string && data.status.size() <= 40
        && data.travelers is int && data.travelers >= 1 && data.travelers <= 100
        && data.currencyCode is string && data.currencyCode.size() <= 8
        && (data.rating == null
            || (data.rating is int && data.rating >= 0 && data.rating <= 5))
        && data.segments is list && data.segments.size() <= 40;
    }

    function validItinerary(data, docId) {
      return data.keys().hasOnly([
               'id', 'ownerId', 'tripId', 'dayNumber',
               'places', 'meals', 'estimatedCost'
             ])
        && data.tripId is string && data.tripId.size() <= 200
        && data.dayNumber is int && data.dayNumber >= 1 && data.dayNumber <= 365
        && docId == data.tripId + '_day_' + string(data.dayNumber)
        && data.places is string && data.places.size() <= 20000
        && data.meals is string && data.meals.size() <= 20000
        && data.estimatedCost is number && data.estimatedCost >= 0;
    }

    function validFeedback(data) {
      return data.keys().hasOnly(['userId', 'tripId', 'rating', 'best', 'worst'])
        && data.userId is string
        && data.tripId is string && data.tripId.size() <= 200
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.best is string && data.best.size() <= 5000
        && data.worst is string && data.worst.size() <= 5000;
    }

    function validDestinationReview(data) {
      return data.keys().hasOnly([
               'ownerId', 'tripId', 'destinationName', 'destinationKey',
               'destinationPlaceId', 'displayName', 'isAnonymous', 'rating',
               'tripStyleTags', 'highlights', 'mustTryFoods',
               'recommendedPlaces', 'body', 'status', 'createdAt', 'updatedAt'
             ])
        && data.ownerId is string
        && data.tripId is string && data.tripId.size() <= 200
        && data.destinationName is string && data.destinationName.size() >= 1
        && data.destinationName.size() <= 200
        && data.destinationKey is string && data.destinationKey.size() >= 1
        && data.destinationKey.size() <= 220
        && (data.destinationPlaceId == null
            || (data.destinationPlaceId is string && data.destinationPlaceId.size() <= 300))
        && data.displayName is string && data.displayName.size() <= 100
        && data.isAnonymous is bool
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.tripStyleTags is list && data.tripStyleTags.size() <= 20
        && data.highlights is list && data.highlights.size() <= 20
        && data.mustTryFoods is list && data.mustTryFoods.size() <= 20
        && data.recommendedPlaces is list && data.recommendedPlaces.size() <= 20
        && data.body is string && data.body.size() >= 12 && data.body.size() <= 5000
        && data.status in ['published', 'private'];
    }

    function validDestinationTip(data) {
      return data.keys().hasOnly([
               'ownerId', 'destinationName', 'destinationKey',
               'destinationPlaceId', 'displayName', 'isAnonymous', 'category',
               'text', 'status', 'likesCount', 'createdAt', 'updatedAt'
             ])
        && data.ownerId is string
        && data.destinationName is string && data.destinationName.size() >= 1
        && data.destinationName.size() <= 200
        && data.destinationKey is string && data.destinationKey.size() >= 1
        && data.destinationKey.size() <= 220
        && (data.destinationPlaceId == null
            || (data.destinationPlaceId is string && data.destinationPlaceId.size() <= 300))
        && data.displayName is string && data.displayName.size() <= 100
        && data.isAnonymous is bool
        && data.category in ['food', 'place', 'warning', 'transport', 'general']
        && data.text is string && data.text.size() >= 6 && data.text.size() <= 1000
        && data.status in ['published', 'private']
        && data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000;
    }

    // ---------------------------------------------------------------------
    // Collections
    // ---------------------------------------------------------------------

    match /users/{userId} {
      // Registration needs its own profile before verification mail is sent.
      // All trip, preference and community access still requires verification.
      allow read, delete: if request.auth != null && uid() == userId;
      allow create, update: if request.auth != null
        && uid() == userId
        && validUser(request.resource.data, userId);
    }

    match /preferences/{id} {
      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data)
        && validPreference(request.resource.data);
      allow update: if owns(resource.data)
        && owns(request.resource.data)
        && validPreference(request.resource.data);
    }

    match /trips/{id} {
      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data)
        && validTrip(request.resource.data, id);
      allow update: if owns(resource.data)
        && owns(request.resource.data)
        && validTrip(request.resource.data, id);
    }

    match /itineraries/{id} {
      allow read, delete: if owns(resource.data)
        || ownsTrip(resource.data.get('tripId', ''));

      allow create: if owns(request.resource.data)
        && ownsTrip(request.resource.data.tripId)
        && validItinerary(request.resource.data, id);

      allow update: if (owns(resource.data)
                        || ownsTrip(resource.data.get('tripId', '')))
        && owns(request.resource.data)
        && request.resource.data.tripId == resource.data.tripId
        && ownsTrip(request.resource.data.tripId)
        && validItinerary(request.resource.data, id);
    }

    match /feedbacks/{id} {
      allow read, delete: if ownedBy(resource.data, 'userId');

      allow create: if ownedBy(request.resource.data, 'userId')
        && ownsTrip(request.resource.data.tripId)
        && validFeedback(request.resource.data);

      allow update: if ownedBy(resource.data, 'userId')
        && ownedBy(request.resource.data, 'userId')
        && ownsTrip(request.resource.data.tripId)
        && validFeedback(request.resource.data);
    }

    match /publicDestinationReviews/{id} {
      allow read: if signedIn()
        && (resource.data.status == 'published'
            || ownedBy(resource.data, 'ownerId'));

      allow create: if ownedBy(request.resource.data, 'ownerId')
        && ownsTrip(request.resource.data.tripId)
        && validDestinationReview(request.resource.data);

      allow update: if ownedBy(resource.data, 'ownerId')
        && ownedBy(request.resource.data, 'ownerId')
        && request.resource.data.tripId == resource.data.tripId
        && validDestinationReview(request.resource.data);

      allow delete: if ownedBy(resource.data, 'ownerId');
    }

    match /destinationTips/{id} {
      allow read: if signedIn()
        && (resource.data.status == 'published'
            || ownedBy(resource.data, 'ownerId'));

      allow create: if ownedBy(request.resource.data, 'ownerId')
        && validDestinationTip(request.resource.data);

      allow update: if ownedBy(resource.data, 'ownerId')
        && ownedBy(request.resource.data, 'ownerId')
        && validDestinationTip(request.resource.data);

      allow delete: if ownedBy(resource.data, 'ownerId');
    }
  }
}
