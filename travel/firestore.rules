rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }
    function ownsTrip(tripId) { return signedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid; }
    match /users/{userId} { allow read, create, update, delete: if signedIn() && request.auth.uid == userId; }
    match /preferences/{id} {
      allow create: if owns(request.resource.data);
      allow read, delete: if owns(resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
    }
    match /trips/{id} {
      allow create: if owns(request.resource.data);
      allow read, delete: if owns(resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
    }
    match /itineraries/{id} {
      allow create: if ownsTrip(request.resource.data.tripId);
      allow read, delete: if ownsTrip(resource.data.tripId);
      allow update: if ownsTrip(resource.data.tripId) && ownsTrip(request.resource.data.tripId);
    }
    match /feedbacks/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && ownsTrip(request.resource.data.tripId);
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && ownsTrip(request.resource.data.tripId);
    }
  }
}
